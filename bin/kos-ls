#!/usr/bin/env node
const command = process.argv[2];
if (command === 'format') {
  process.exitCode = require('../dist/format.js').main(process.argv.slice(3));
} else if (command === 'check' || command === 'size') {
  require(`../dist/${command}.js`)
    .main(process.argv.slice(3))
    .then((status) => (process.exitCode = status));
} else {
  require('../dist/server.js');
}
