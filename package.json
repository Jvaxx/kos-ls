{
  "name": "kos-ls",
  "description": "Language server for Kerboscript, the language of the kOS mod for Kerbal Space Program. Maintained fork of kos-language-server.",
  "version": "2.0.0-dev",
  "main": "dist/server.js",
  "bin": {
    "kos-ls": "./bin/kos-ls",
    "kls": "./bin/kos-ls"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.LICENSE.txt",
    "bin/kos-ls",
    "THIRD_PARTY_NOTICES.md",
    "LICENSES/",
    "src/",
    "tools/",
    "data/",
    "test/",
    "benchmark/",
    "docs/",
    "third_party/",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "webpack.config.js",
    "jest.config.js",
    "eslint.config.mjs",
    "zakzak.config.json",
    ".prettierrc"
  ],
  "author": "Jvaxx",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "denque": "^2.1.0",
    "jsonc-parser": "^3.3.0",
    "ts-set-utils": "^0.2.0",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "keywords": [
    "Kerbal Operating System",
    "kos",
    "Kerbal Space Program",
    "ksp",
    "language-server",
    "lsp",
    "neovim"
  ],
  "scripts": {
    "clean": "node tools/clean.js",
    "build": "tsc -p ./tsconfig.json",
    "bundle": "webpack --config ./webpack.config.js --mode production",
    "lint": "eslint .",
    "prettier": "prettier --write \"{src,test,benchmark,tools}/**/*.{ts,js,mjs}\"",
    "prettier:check": "prettier --check \"{src,test,benchmark,tools}/**/*.{ts,js,mjs}\"",
    "pretest": "tsc -p ./tsconfig.json",
    "test": "jest --config jest.config.js",
    "prebench": "npm run build",
    "bench": "zakzak -c ./zakzak.config.json",
    "probe": "node tools/lsp-probe.js",
    "kos-db": "node out/tools/kos-db/generate.js",
    "prepare:package": "node tools/prepare-package.js",
    "prepack": "npm run build && npm run bundle && npm test && npm run prepare:package"
  },
  "devDependencies": {
    "@dynatrace/zakzak": "^0.6.6",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jstat": "^1.9.6",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3"
  },
  "contributors": [
    "John Chabot (original author)"
  ]
}
