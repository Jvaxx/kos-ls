{
  "name": "kos-ls",
  "description": "Language server for Kerboscript, the language of the kOS mod for Kerbal Space Program. Maintained fork of kos-language-server.",
  "version": "2.0.0-dev",
  "main": "dist/server.js",
  "bin": {
    "kos-ls": "./bin/kos-ls",
    "kls": "./bin/kos-ls"
  },
  "files": [
    "dist/**/*",
    "bin"
  ],
  "author": "Jvaxx",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "denque": "^2.1.0",
    "jsonc-parser": "^3.3.0",
    "ts-set-utils": "^0.2.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-uri": "^3.0.8"
  },
  "keywords": [
    "Kerbal Operating System",
    "kos",
    "Kerbal Space Program",
    "ksp",
    "language-server",
    "lsp",
    "neovim"
  ],
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "bundle": "webpack --config ./webpack.config.js --mode production",
    "pretest": "tsc -p ./tsconfig.json",
    "test": "jest --config jest.config.js",
    "bench": "zakzak -c ./zakzak.config.json",
    "probe": "node tools/lsp-probe.js",
    "kos-db": "node out/tools/kos-db/generate.js",
    "prepack": "npm run build && npm run bundle && npm test"
  },
  "devDependencies": {
    "@dynatrace/zakzak": "^0.6.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.6.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jstat": "^1.9.6",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "contributors": [
    "John Chabot (original author)"
  ]
}
